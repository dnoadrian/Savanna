{
  "name": "snowdown",
  "version": "1.0.0",
  "description": "SNOWDOWN – Low-Poly Battle-Royale im Browser: verschneite Insel Frostfeste, Solo & Duo, 20 Spieler, Truhen, Waffen, Schilde (Three.js + Web Audio + Node.js/WebSocket)",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "online": "node server/index.js --online",
    "spielen": "node server/index.js --online --open",
    "build:pages": "node scripts/build-pages.js",
    "test": "node tests/run-tests.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "homepage": "https://dnoadrian.github.io/Snowdown/",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnoadrian/Snowdown.git"
  },
  "showdown": {
    "server": "https://snowdown.onrender.com"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "three": "^0.186.1",
    "ws": "^8.21.3"
  }
}
